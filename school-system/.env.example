# Copy to .env and replace all example passwords and secrets before deploying.
MYSQL_DATABASE=school_system
MYSQL_USER=school_app
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password

# Optional DB connection overrides. The defaults target the Compose MySQL service.
DB_HOST=db
DB_PORT=3306
# Set SPRING_DATASOURCE_URL only when overriding the generated local JDBC URL.
SPRING_DATASOURCE_URL=
# Optional credentials overrides; blank values use MYSQL_USER/MYSQL_PASSWORD.
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

PROXY_PORT=8080
FRONTEND_URL=http://localhost:8080

# Generate distinct random values (for example, with: openssl rand -base64 32)
JWT_SECRET=replace-with-a-long-random-jwt-secret
RESULTS_TOKEN_ENCRYPTION_KEY=replace-with-a-long-random-encryption-key

# Optional integrations; set these if those application features are used.
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
RECAPTCHA_SECRET=
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
MOBITECH_API_KEY=
MOBITECH_SENDER_NAME=
MOBITECH_SERVICE_ID=0
